# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Datasets & large binary/data files (exclude by directory, not extension)
# *.json and *.jsonl NOT globally excluded — reference/paper_jsons/ must be tracked
*.csv
*.parquet
*.arrow
*.jpg
*.jpeg
*.png
*.dcm
*.zip
*.tar
*.gz
*.pdf

# Data directory at repo root (medical images, label CSVs, preprocessed files)
# Leading slash = root-only match; does NOT exclude src/data/
/data/
/dataset/

# Third-party reference repos (cloned, not owned by this project)
external/

# Model outputs
checkpoints/
outputs/
runs/
wandb/

# All experiment results (checkpoints, logs, metrics, predictions)
result/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Rust build artifacts
src/nlp_cxr_rs/target/

# Tooling & local context (never push)
.claude/
context/
.python-version
.coverage
.pytest_cache/

# Third-party reference repos (cloned, not ours)
repo/

# Archived prior-project (report generation) — kept local, never pushed
attic/

# Model weights
*.pt
*.pth
*.safetensors
*.bin

# Configs (training/grid/dataset-registry configs, not for public release)
configs/

# Per-image prediction/ground-truth exports (dataset-adjacent, large binary)
document/*.xlsx
document/localization_bboxes_*.yaml

# Stale internal analysis bundle (superseded, contains configs + large csvs)
analysis_export/

# Personal notes (advisor meetings, working-hours reconstructed from AI session activity)
notes/

# One-off personal download helper (hardcoded PhysioNet username)
scripts/download_vindr_cxr_test.ps1

# LaTeX build artifacts
document/latex/*.aux
document/latex/*.log
document/latex/*.fls
document/latex/*.fdb_latexmk

# Paper draft figures/tables ARE the deliverable, not dataset files —
# override the blanket *.png / *.csv excludes above for this folder only
!draft/figures/*.png
!draft/tables/*.csv
